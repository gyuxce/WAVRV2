  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerOpportunity CustomerOpportunity? @relation(fields: [customerOpportunityId], references: [id], onDelete: SetNull)

  @@unique([campaignId, customerId], map: "campaign_audience_members_customer_key")
  @@index([organizationId, customerId], map: "campaign_audience_members_customer_idx")
  @@map("campaign_audience_members")
}

model GrowthOutcome {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @map("organization_id") @db.Uuid
  customerId            String                @map("customer_id") @db.Uuid
  customerOpportunityId String                @map("customer_opportunity_id") @db.Uuid
  growthActionId        String?               @map("growth_action_id") @db.Uuid
  transactionId         String                @unique @map("transaction_id") @db.Uuid
  classification        OutcomeClassification
  attributedAmount      Decimal               @map("attributed_amount") @db.Decimal(18, 2)
  attributionWindowDays Int                   @map("attribution_window_days")
  recordedAt            DateTime              @default(now()) @map("recorded_at") @db.Timestamptz(3)

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerOpportunity CustomerOpportunity @relation(fields: [customerOpportunityId], references: [id], onDelete: Restrict)
  growthAction        GrowthAction?       @relation(fields: [growthActionId], references: [id], onDelete: Restrict)
  transaction         Transaction         @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([organizationId, customerId, recordedAt(sort: Desc)], map: "growth_outcomes_customer_time_idx")
  @@index([customerOpportunityId], map: "growth_outcomes_opportunity_idx")
  @@map("growth_outcomes")
}

model ImportJob {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  type           ImportType
  mode           ImportMode      @default(STRICT)
  filename       String          @db.VarChar(255)
  storageKey     String          @map("storage_key") @db.VarChar(500)
  status         ImportJobStatus @default(UPLOADED)
  totalRows      Int             @default(0) @map("total_rows")
  validRows      Int             @default(0) @map("valid_rows")
  invalidRows    Int             @default(0) @map("invalid_rows")
  duplicateRows  Int             @default(0) @map("duplicate_rows")
  conflictRows   Int             @default(0) @map("conflict_rows")
  importedRows   Int             @default(0) @map("imported_rows")
  createdById    String          @map("created_by_id") @db.Uuid
  startedAt      DateTime?       @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    OrganizationUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  rows         ImportRow[]

  @@index([organizationId, status, createdAt(sort: Desc)], map: "import_jobs_status_time_idx")
  @@map("import_jobs")
}

model ImportRow {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  importJobId      String          @map("import_job_id") @db.Uuid
  rowNumber        Int             @map("row_number")
  rawData          Json            @map("raw_data") @db.JsonB
  normalizedData   Json?           @map("normalized_data") @db.JsonB
  status           ImportRowStatus @default(STAGED)
  targetEntityType String?         @map("target_entity_type") @db.VarChar(80)
  targetEntityId   String?         @map("target_entity_id") @db.Uuid
  errorCodes       Json?           @map("error_codes") @db.JsonB
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importJob    ImportJob    @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([importJobId, rowNumber], map: "import_rows_job_row_key")
  @@index([organizationId, status], map: "import_rows_status_idx")
  @@map("import_rows")
}

model IntegrationConnection {
