generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  MERGED
  ANONYMIZED
}

enum IdentifierType {
  QR
  NFC
  RFID
  MEMBERSHIP_NUMBER
}

enum IdentifierStatus {
  ACTIVE
  REVOKED
  LOST
}

enum ConsentPurpose {
  MARKETING
  TRANSACTIONAL
  LOYALTY
}

enum ConsentChannel {
  WHATSAPP
  EMAIL
  SMS
}

enum ConsentStatus {
  GRANTED
  DENIED
  REVOKED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum VisitType {
  CHECK_IN
  APPOINTMENT
  MANUAL
  TRANSACTION_DERIVED
}

enum VisitStatus {
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TransactionType {
  SALE
  REFUND
}

enum TransactionStatus {
  COMPLETED
  VOIDED
}

enum LoyaltyProgramStatus {
  ACTIVE
  INACTIVE
}

enum PointLedgerType {
  EARN
  REDEEM
  REFUND
  EXPIRE
  ADJUSTMENT
}

enum SegmentMembershipStatus {
  ACTIVE
  EXITED
}

enum OpportunityType {
  INACTIVE
  FREQUENCY_DECLINE
  CROSS_SELL
  NEAR_TIER
}

enum OpportunityStatus {
  OPEN
  IN_PROGRESS
  ACTIONED
  WON
  RESOLVED_ORGANIC
  DISMISSED
  EXPIRED
}

enum GrowthActionType {
  WHATSAPP_OPENED
  WHATSAPP_MARKED_CONTACTED
  PHONE_CALL
  STAFF_FOLLOW_UP
  OFFER_RECORDED
  CAMPAIGN_TOUCH
}

enum GrowthActionChannel {
  WHATSAPP
  PHONE
  IN_PERSON
  OTHER
}

enum GrowthActionStatus {
  NOT_STARTED
  OPENED
  MARKED_CONTACTED
  COMPLETED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OutcomeClassification {
  ORGANIC_RETURN
  RETURN_AFTER_ACTION
}

enum ImportType {
  CUSTOMERS
  TRANSACTIONS
  TRANSACTION_ITEMS
  VISITS
}

enum ImportMode {
  STRICT
  VALID_ROWS_ONLY
}

enum ImportJobStatus {
  UPLOADED
  VALIDATING
  NEEDS_REVIEW
  READY
  COMMITTING
  COMPLETED
  PARTIAL
  FAILED
}

enum ImportRowStatus {
  STAGED
  VALID
  POSSIBLE_DUPLICATE
  CONFLICT
  SKIPPED_DUPLICATE
  IMPORTED
  FAILED
}

enum IntegrationStatus {
  CONNECTED
  DEGRADED
  DISCONNECTED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(150)
  slug               String             @unique @db.VarChar(80)
  defaultCountryCode String             @default("ID") @map("default_country_code") @db.Char(2)
  timezone           String             @default("Asia/Jakarta") @db.VarChar(64)
  currency           String             @default("IDR") @db.Char(3)
  industryPreset     String?            @map("industry_preset") @db.VarChar(50)
  status             OrganizationStatus @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches                   Branch[]
  organizationUsers          OrganizationUser[]
  roles                      Role[]
  customers                  Customer[]
  customerExternalReferences CustomerExternalReference[]
  customerIdentifiers        CustomerIdentifier[]
  consentRecords             ConsentRecord[]
  customerMerges             CustomerMerge[]
  services                   Service[]
  visits                     Visit[]
  transactions               Transaction[]
  transactionItems           TransactionItem[]
  loyaltyPrograms            LoyaltyProgram[]
  loyaltyAccounts            LoyaltyAccount[]
  tiers                      Tier[]
  pointLedgerEntries         PointLedger[]
  customerMetrics            CustomerMetric[]
  segmentDefinitions         SegmentDefinition[]
  segmentMemberships         SegmentMembership[]
  opportunityDefinitions     OpportunityDefinition[]
  customerOpportunities      CustomerOpportunity[]
  growthActions              GrowthAction[]
  campaigns                  Campaign[]
  campaignAudienceMembers    CampaignAudienceMember[]
  growthOutcomes             GrowthOutcome[]
  importJobs                 ImportJob[]
  importRows                 ImportRow[]
  integrationConnections     IntegrationConnection[]
  outboxEvents               OutboxEvent[]
  auditLogs                  AuditLog[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(40)
  name           String       @db.VarChar(150)
  timezone       String       @default("Asia/Jakarta") @db.VarChar(64)
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userScopes    UserBranchScope[]
  homeCustomers Customer[]        @relation("CustomerHomeBranch")
  visits        Visit[]
  transactions  Transaction[]
  growthActions GrowthAction[]

  @@unique([organizationId, code], map: "branches_organization_code_key")
  @@index([organizationId, status], map: "branches_organization_status_idx")
  @@map("branches")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @db.VarChar(320)
  normalizedEmail String     @unique @map("normalized_email") @db.VarChar(320)
  name            String     @db.VarChar(150)
  status          UserStatus @default(INVITED)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizationMemberships OrganizationUser[]

  @@map("users")
}

model OrganizationUser {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branchScopes       UserBranchScope[]
  performedMerges    CustomerMerge[]
  pointLedgerEntries PointLedger[]
  growthActions      GrowthAction[]
  approvedCampaigns  Campaign[]
  importJobs         ImportJob[]
  auditLogs          AuditLog[]

  @@unique([organizationId, userId], map: "organization_users_membership_key")
  @@index([organizationId, roleId], map: "organization_users_role_idx")
  @@map("organization_users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(60)
  name           String   @db.VarChar(100)
  description    String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  OrganizationUser[]
  permissions  RolePermission[]

  @@unique([organizationId, key], map: "roles_organization_key_key")
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserBranchScope {
  organizationUserId String @map("organization_user_id") @db.Uuid
  branchId           String @map("branch_id") @db.Uuid

  organizationUser OrganizationUser @relation(fields: [organizationUserId], references: [id], onDelete: Cascade)
  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([organizationUserId, branchId])
  @@map("user_branch_scopes")
}

model Customer {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  displayName     String         @map("display_name") @db.VarChar(150)
  normalizedName  String         @map("normalized_name") @db.VarChar(150)
  primaryPhone    String?        @map("primary_phone") @db.VarChar(32)
  normalizedPhone String?        @map("normalized_phone") @db.VarChar(20)
  primaryEmail    String?        @map("primary_email") @db.VarChar(320)
  normalizedEmail String?        @map("normalized_email") @db.VarChar(320)
  birthDate       DateTime?      @map("birth_date") @db.Date
  homeBranchId    String?        @map("home_branch_id") @db.Uuid
  status          CustomerStatus @default(ACTIVE)
  mergedIntoId    String?        @map("merged_into_customer_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  homeBranch         Branch?                     @relation("CustomerHomeBranch", fields: [homeBranchId], references: [id], onDelete: SetNull)
  mergedInto         Customer?                   @relation("CustomerMergeRedirect", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedCustomers    Customer[]                  @relation("CustomerMergeRedirect")
  externalReferences CustomerExternalReference[]
  identifiers        CustomerIdentifier[]
  consentRecords     ConsentRecord[]
  survivorMerges     CustomerMerge[]             @relation("MergeSurvivor")
  duplicateMerges    CustomerMerge[]             @relation("MergeDuplicate")
  visits             Visit[]
  transactions       Transaction[]
  loyaltyAccounts    LoyaltyAccount[]
  metric             CustomerMetric?
  segmentMemberships SegmentMembership[]
  opportunities      CustomerOpportunity[]
  growthActions      GrowthAction[]
  campaignAudiences  CampaignAudienceMember[]
  outcomes           GrowthOutcome[]

  @@index([organizationId, normalizedPhone], map: "customers_organization_phone_idx")
  @@index([organizationId, normalizedEmail], map: "customers_organization_email_idx")
  @@index([organizationId, normalizedName], map: "customers_organization_name_idx")
  @@index([organizationId, status], map: "customers_organization_status_idx")
  @@map("customers")
}

model CustomerExternalReference {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  customerId         String   @map("customer_id") @db.Uuid
  sourceSystem       String   @map("source_system") @db.VarChar(80)
  externalCustomerId String   @map("external_customer_id") @db.VarChar(120)
  firstSeenAt        DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt         DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceSystem, externalCustomerId], map: "customer_external_references_source_key")
  @@index([customerId], map: "customer_external_references_customer_idx")
  @@map("customer_external_references")
}

model CustomerIdentifier {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  customerId     String           @map("customer_id") @db.Uuid
  type           IdentifierType
  tokenHash      String?          @unique @map("token_hash") @db.VarChar(128)
  displayCode    String?          @map("display_code") @db.VarChar(100)
  status         IdentifierStatus @default(ACTIVE)
  assignedAt     DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([organizationId, type, displayCode], map: "customer_identifiers_display_code_key")
  @@index([organizationId, customerId, status], map: "customer_identifiers_customer_status_idx")
  @@map("customer_identifiers")
}

model ConsentRecord {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  purpose        ConsentPurpose
  channel        ConsentChannel
  status         ConsentStatus
  source         String         @db.VarChar(80)
  recordedAt     DateTime       @map("recorded_at") @db.Timestamptz(3)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(3)
  proofMetadata  Json?          @map("proof_metadata") @db.JsonB
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([organizationId, customerId, purpose, channel, recordedAt(sort: Desc)], map: "consent_records_lookup_idx")
  @@map("consent_records")
}

model CustomerMerge {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  survivorCustomerId  String   @map("survivor_customer_id") @db.Uuid
  duplicateCustomerId String   @map("duplicate_customer_id") @db.Uuid
  reason              String   @db.VarChar(255)
  performedById       String   @map("performed_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  survivor     Customer         @relation("MergeSurvivor", fields: [survivorCustomerId], references: [id], onDelete: Restrict)
  duplicate    Customer         @relation("MergeDuplicate", fields: [duplicateCustomerId], references: [id], onDelete: Restrict)
  performedBy  OrganizationUser @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, duplicateCustomerId], map: "customer_merges_duplicate_key")
  @@index([survivorCustomerId], map: "customer_merges_survivor_idx")
  @@map("customer_merges")
}

model Service {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  code           String        @db.VarChar(80)
  name           String        @db.VarChar(150)
  category       String        @db.VarChar(100)
  status         ServiceStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transactionItems TransactionItem[]

  @@unique([organizationId, code], map: "services_organization_code_key")
  @@index([organizationId, category, status], map: "services_category_status_idx")
  @@map("services")
}

model Visit {
  id                       String      @id @default(uuid()) @db.Uuid
  organizationId           String      @map("organization_id") @db.Uuid
  branchId                 String      @map("branch_id") @db.Uuid
  customerId               String      @map("customer_id") @db.Uuid
  sourceSystem             String      @map("source_system") @db.VarChar(80)
  externalVisitId          String?     @map("external_visit_id") @db.VarChar(120)
  type                     VisitType
  startedAt                DateTime    @map("started_at") @db.Timestamptz(3)
  endedAt                  DateTime?   @map("ended_at") @db.Timestamptz(3)
  status                   VisitStatus @default(COMPLETED)
  derivedFromTransactionId String?     @unique @map("derived_from_transaction_id") @db.Uuid
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                 Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer               Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  derivedFromTransaction Transaction? @relation("DerivedVisitTransaction", fields: [derivedFromTransactionId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceSystem, externalVisitId], map: "visits_external_source_key")
  @@index([organizationId, customerId, startedAt(sort: Desc)], map: "visits_customer_time_idx")
  @@index([organizationId, branchId, startedAt(sort: Desc)], map: "visits_branch_time_idx")
  @@map("visits")
}

model Transaction {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  branchId              String            @map("branch_id") @db.Uuid
  customerId            String            @map("customer_id") @db.Uuid
  sourceSystem          String            @map("source_system") @db.VarChar(80)
  externalTransactionId String            @map("external_transaction_id") @db.VarChar(120)
  type                  TransactionType
  status                TransactionStatus @default(COMPLETED)
  occurredAt            DateTime          @map("occurred_at") @db.Timestamptz(3)
  currency              String            @db.Char(3)
  grossAmount           Decimal           @map("gross_amount") @db.Decimal(18, 2)
  discountAmount        Decimal           @default(0) @map("discount_amount") @db.Decimal(18, 2)
  netAmount             Decimal           @map("net_amount") @db.Decimal(18, 2)
  refundOfTransactionId String?           @map("refund_of_transaction_id") @db.Uuid
  sourcePayloadHash     String            @map("source_payload_hash") @db.VarChar(64)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  refundOf     Transaction?      @relation("TransactionRefunds", fields: [refundOfTransactionId], references: [id], onDelete: Restrict)
  refunds      Transaction[]     @relation("TransactionRefunds")
  items        TransactionItem[]
  derivedVisit Visit?            @relation("DerivedVisitTransaction")
  pointEntries PointLedger[]
  outcome      GrowthOutcome?

  @@unique([organizationId, sourceSystem, externalTransactionId], map: "transactions_source_key")
  @@index([organizationId, customerId, occurredAt(sort: Desc)], map: "transactions_customer_time_idx")
  @@index([organizationId, branchId, occurredAt(sort: Desc)], map: "transactions_branch_time_idx")
  @@index([refundOfTransactionId], map: "transactions_refund_of_idx")
  @@map("transactions")
}

model TransactionItem {
  id                      String  @id @default(uuid()) @db.Uuid
  organizationId          String  @map("organization_id") @db.Uuid
  transactionId           String  @map("transaction_id") @db.Uuid
  lineNumber              Int     @map("line_number")
  serviceId               String? @map("service_id") @db.Uuid
  serviceNameSnapshot     String  @map("service_name_snapshot") @db.VarChar(150)
  serviceCategorySnapshot String  @map("service_category_snapshot") @db.VarChar(100)
  quantity                Decimal @db.Decimal(12, 3)
  unitAmount              Decimal @map("unit_amount") @db.Decimal(18, 2)
  lineAmount              Decimal @map("line_amount") @db.Decimal(18, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transaction  Transaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([transactionId, lineNumber], map: "transaction_items_line_key")
  @@index([organizationId, serviceCategorySnapshot], map: "transaction_items_category_idx")
  @@map("transaction_items")
}

model LoyaltyProgram {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String               @db.VarChar(120)
  status         LoyaltyProgramStatus @default(INACTIVE)
  earnRule       Json                 @map("earn_rule") @db.JsonB
  expiryRule     Json?                @map("expiry_rule") @db.JsonB
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accounts     LoyaltyAccount[]
  tiers        Tier[]

  @@index([organizationId, status], map: "loyalty_programs_status_idx")
  @@map("loyalty_programs")
}

model Tier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  name           String   @db.VarChar(80)
  threshold      Decimal  @db.Decimal(18, 2)
  rank           Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program         LoyaltyProgram   @relation(fields: [programId], references: [id], onDelete: Restrict)
  currentAccounts LoyaltyAccount[]

  @@unique([programId, rank], map: "tiers_program_rank_key")
  @@unique([programId, name], map: "tiers_program_name_key")
  @@map("tiers")
}

model LoyaltyAccount {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  currentTierId  String?  @map("current_tier_id") @db.Uuid
  cachedBalance  Decimal  @default(0) @map("cached_balance") @db.Decimal(18, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program      LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currentTier  Tier?          @relation(fields: [currentTierId], references: [id], onDelete: SetNull)
  ledger       PointLedger[]

  @@unique([programId, customerId], map: "loyalty_accounts_program_customer_key")
  @@index([organizationId, customerId], map: "loyalty_accounts_customer_idx")
  @@map("loyalty_accounts")
}

model PointLedger {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  accountId      String          @map("account_id") @db.Uuid
  transactionId  String?         @map("transaction_id") @db.Uuid
  type           PointLedgerType
  amount         Decimal         @db.Decimal(18, 2)
  balanceAfter   Decimal         @map("balance_after") @db.Decimal(18, 2)
  expiresAt      DateTime?       @map("expires_at") @db.Timestamptz(3)
  reason         String          @db.VarChar(255)
  createdById    String?         @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      LoyaltyAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction  Transaction?      @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdBy    OrganizationUser? @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt], map: "point_ledger_account_time_idx")
  @@index([transactionId], map: "point_ledger_transaction_idx")
  @@map("point_ledger")
}

model CustomerMetric {
  id                        String    @id @default(uuid()) @db.Uuid
  organizationId            String    @map("organization_id") @db.Uuid
  customerId                String    @unique @map("customer_id") @db.Uuid
  lastVisitAt               DateTime? @map("last_visit_at") @db.Timestamptz(3)
  visitCount30d             Int       @default(0) @map("visit_count_30d")
  visitCount90d             Int       @default(0) @map("visit_count_90d")
  netSpend90d               Decimal   @default(0) @map("net_spend_90d") @db.Decimal(18, 2)
  netSpend365d              Decimal   @default(0) @map("net_spend_365d") @db.Decimal(18, 2)
  lifetimeValue             Decimal   @default(0) @map("lifetime_value") @db.Decimal(18, 2)
  averageOrderValue         Decimal   @default(0) @map("average_order_value") @db.Decimal(18, 2)
  expectedVisitIntervalDays Decimal?  @map("expected_visit_interval_days") @db.Decimal(8, 2)
  computedAt                DateTime  @map("computed_at") @db.Timestamptz(3)
  version                   Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, lastVisitAt], map: "customer_metrics_last_visit_idx")
  @@map("customer_metrics")
}

model SegmentDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(80)
  name           String   @db.VarChar(120)
  ruleType       String   @map("rule_type") @db.VarChar(80)
  parameters     Json     @db.JsonB
  enabled        Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  SegmentMembership[]

  @@unique([organizationId, key, version], map: "segment_definitions_key_version_key")
  @@index([organizationId, enabled], map: "segment_definitions_enabled_idx")
  @@map("segment_definitions")
}

model SegmentMembership {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  segmentDefinitionId String                  @map("segment_definition_id") @db.Uuid
  customerId          String                  @map("customer_id") @db.Uuid
  status              SegmentMembershipStatus @default(ACTIVE)
  reasonText          String                  @map("reason_text") @db.VarChar(500)
  reasonData          Json                    @map("reason_data") @db.JsonB
  enteredAt           DateTime                @map("entered_at") @db.Timestamptz(3)
  lastEvaluatedAt     DateTime                @map("last_evaluated_at") @db.Timestamptz(3)
  exitedAt            DateTime?               @map("exited_at") @db.Timestamptz(3)

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  segmentDefinition SegmentDefinition     @relation(fields: [segmentDefinitionId], references: [id], onDelete: Restrict)
  customer          Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  opportunities     CustomerOpportunity[]

  @@unique([segmentDefinitionId, customerId], where: { status: "ACTIVE" }, map: "segment_memberships_one_active_key")
  @@index([organizationId, customerId, status], map: "segment_memberships_customer_status_idx")
  @@map("segment_memberships")
}

model OpportunityDefinition {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  key                   String          @db.VarChar(80)
  type                  OpportunityType
  parameters            Json            @db.JsonB
  priority              Int
  cooldownDays          Int             @default(30) @map("cooldown_days")
  attributionWindowDays Int             @default(30) @map("attribution_window_days")
  enabled               Boolean         @default(true)
  version               Int             @default(1)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunities CustomerOpportunity[]

  @@unique([organizationId, key, version], map: "opportunity_definitions_key_version_key")
  @@index([organizationId, enabled, priority(sort: Desc)], map: "opportunity_definitions_priority_idx")
  @@map("opportunity_definitions")
}

model CustomerOpportunity {
  id                        String            @id @default(uuid()) @db.Uuid
  organizationId            String            @map("organization_id") @db.Uuid
  definitionId              String            @map("definition_id") @db.Uuid
  customerId                String            @map("customer_id") @db.Uuid
  sourceSegmentMembershipId String?           @map("source_segment_membership_id") @db.Uuid
  status                    OpportunityStatus @default(OPEN)
  reasonText                String            @map("reason_text") @db.VarChar(500)
  reasonData                Json              @map("reason_data") @db.JsonB
  estimatedValue            Decimal?          @map("estimated_value") @db.Decimal(18, 2)
  openedAt                  DateTime          @map("opened_at") @db.Timestamptz(3)
  expiresAt                 DateTime?         @map("expires_at") @db.Timestamptz(3)
  actionedAt                DateTime?         @map("actioned_at") @db.Timestamptz(3)
  resolvedAt                DateTime?         @map("resolved_at") @db.Timestamptz(3)
  dismissedReason           String?           @map("dismissed_reason") @db.VarChar(255)
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  definition              OpportunityDefinition    @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  customer                Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceSegmentMembership SegmentMembership?       @relation(fields: [sourceSegmentMembershipId], references: [id], onDelete: SetNull)
  actions                 GrowthAction[]
  campaignAudiences       CampaignAudienceMember[]
  outcomes                GrowthOutcome[]

  @@unique([definitionId, customerId], where: raw("\"status\" IN ('OPEN', 'IN_PROGRESS', 'ACTIONED')"), map: "customer_opportunities_one_active_key")
  @@index([organizationId, status, openedAt(sort: Desc)], map: "customer_opportunities_work_queue_idx")
  @@index([organizationId, customerId, status], map: "customer_opportunities_customer_idx")
  @@map("customer_opportunities")
}

model GrowthAction {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  customerOpportunityId String              @map("customer_opportunity_id") @db.Uuid
  customerId            String              @map("customer_id") @db.Uuid
  campaignId            String?             @map("campaign_id") @db.Uuid
  branchId              String?             @map("branch_id") @db.Uuid
  type                  GrowthActionType
  channel               GrowthActionChannel
  status                GrowthActionStatus  @default(NOT_STARTED)
  messagePreview        String?             @map("message_preview") @db.Text
  performedById         String?             @map("performed_by_id") @db.Uuid
  openedAt              DateTime?           @map("opened_at") @db.Timestamptz(3)
  performedAt           DateTime?           @map("performed_at") @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerOpportunity CustomerOpportunity @relation(fields: [customerOpportunityId], references: [id], onDelete: Restrict)
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  campaign            Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  performedBy         OrganizationUser?   @relation(fields: [performedById], references: [id], onDelete: Restrict)
  outcomes            GrowthOutcome[]

  @@index([organizationId, customerId, createdAt(sort: Desc)], map: "growth_actions_customer_time_idx")
  @@index([customerOpportunityId, status], map: "growth_actions_opportunity_status_idx")
  @@map("growth_actions")
}

model Campaign {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  name           String              @db.VarChar(150)
  status         CampaignStatus      @default(DRAFT)
  channel        GrowthActionChannel
  approvedById   String?             @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?           @map("approved_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  approvedBy   OrganizationUser?        @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  actions      GrowthAction[]
  audience     CampaignAudienceMember[]

  @@index([organizationId, status, createdAt(sort: Desc)], map: "campaigns_status_time_idx")
  @@map("campaigns")
}

model CampaignAudienceMember {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  campaignId            String   @map("campaign_id") @db.Uuid
  customerId            String   @map("customer_id") @db.Uuid
